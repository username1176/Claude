# ZeroTax AI — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# Required: Anthropic API key for Claude claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: OpenAI API key for RAG embeddings
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Custom SQLite database path (default: zerotax.db in current dir)
# ZEROTAX_DB=/path/to/data/zerotax.db
